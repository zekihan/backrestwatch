{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusters",
        "pollIntervalSeconds",
        "maxSampleAgeSeconds",
        "maxAgeSeconds",
        "requestTimeoutSeconds",
        "collectionTimeoutSeconds"
      ],
      "properties": {
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "maxSampleAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "collectionTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31622400
        },
        "clusters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "repos"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "repos": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 4,
                "patternProperties": {
                  "^repo[1-4]$": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "maxAgeSeconds": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 31622400
                      }
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiPeers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9:.]+/[0-9]{1,3}$"
          }
        },
        "apiPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "ingressFrom": {
          "type": "array"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    }
  }
}
